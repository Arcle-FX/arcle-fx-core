# ==============================================================================
#  ArcleFX — Environment Variables
#  Copy this file to .env and fill in your values. Never commit .env to git.
# ==============================================================================

# ─── Deployer ─────────────────────────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=0x...

# ─── Fee Recipients (used across all chains) ──────────────────────────────────
PROTOCOL_FEE_RECIPIENT=0x...   # 80% share
DEV_FEE_RECIPIENT=0x...        # 20% share

# ─── RPC Endpoints ────────────────────────────────────────────────────────────
# Arc Testnet  (Chain ID: 5042002)
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io

# Ethereum Sepolia  (Chain ID: 11155111)
ETH_SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Arbitrum Sepolia  (Chain ID: 421614)
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Base Sepolia  (Chain ID: 84532)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ─── Explorer API Keys (for --verify) ─────────────────────────────────────────
ARC_EXPLORER_API_KEY=           # https://testnet.arcscan.app
ETH_EXPLORER_API_KEY=           # https://etherscan.io/apis
ARB_EXPLORER_API_KEY=           # https://arbiscan.io/apis
BASE_EXPLORER_API_KEY=          # https://basescan.org/apis

# ─── Token Addresses ──────────────────────────────────────────────────────────
#  Arc Testnet
ARC_USDC=
ARC_EURC=
ARC_CIR_BTC=

#  Ethereum Sepolia
ETH_SEPOLIA_USDC=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
ETH_SEPOLIA_EURC=

#  Arbitrum Sepolia
ARB_SEPOLIA_USDC=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
ARB_SEPOLIA_EURC=

#  Base Sepolia
BASE_SEPOLIA_USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e
BASE_SEPOLIA_EURC=
